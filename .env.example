# Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database Configuration (MongoDB Community or Embedded Zero-Config Fallback)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=fuelflux_cng_demo

# Python & Computer Vision Pipeline (YOLOv8 Plate Detection + EasyOCR)
PYTHON_EXECUTABLE=python
CV_WORKER_SCRIPT=./cv_worker/scan_media.py
YOLO_PLATE_MODEL=./cv_worker/models/yolov8n_plate.pt
OCR_MIN_CONFIDENCE=0.80

# Video Processing & Frame Sampling Defaults
VIDEO_SAMPLE_FPS=1.5
MAX_VIDEO_FRAMES=40
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=120

# Business Rules & Hydrotesting Thresholds
DUE_SOON_DAYS=30
STATION_TIMEZONE=Asia/Kolkata

# Demo & Synthetic Seed Data Flags
DEMO_MODE=true
ALLOW_DEMO_SEED=true
ALLOW_DEMO_RESET=false
