NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=fuelflux_cng_demo
PUBLIC_BASE_URL=http://localhost:3000
PYTHON_EXECUTABLE=python
CV_WORKER_SCRIPT=./cv_worker/scan_media.py
# India-specific OCR path; run `python scripts/setup-indian-ocr.py` first.
ALPR_ENGINE=fast_alpr_india
ALPR_DETECTOR_MODEL=yolo-v9-s-608-license-plate-end2end
ALPR_DETECTOR_CONFIDENCE=0.22
ALPR_ALLOW_GENERIC_FALLBACK=false
ALPR_OCR_MODEL=cct-s-v2-global-model
ALPR_GPU=false
AWIROS_DEVICE=cpu
AWIROS_RETRY_BELOW=0.82
OCR_MIN_CONFIDENCE=0.80
VIDEO_SAMPLE_FPS=5
MAX_VIDEO_FRAMES=300
MIN_CONSENSUS_FRAMES=3
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=120
DUE_SOON_DAYS=30
STATION_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
ALLOW_DEMO_SEED=true
ALLOW_DEMO_RESET=false
CCTV_MAX_CONCURRENT=2
CCTV_SAMPLE_INTERVAL_SECONDS=1.0
CCTV_EVENT_COOLDOWN_SECONDS=20
CCTV_MIN_CONSENSUS_VOTES=3
